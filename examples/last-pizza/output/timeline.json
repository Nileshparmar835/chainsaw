  "captions": [
    {
      "start": 0.0,
      "end": 1.4506666666666668,
      "text": "My pizza sued me."
    },
    {
      "start": 1.5706666666666667,
      "end": 3.021333333333333,
      "text": "You ate my dad."
    },
    {
      "start": 3.1413333333333333,
      "end": 5.1466666666666665,
      "text": "Exhibit A. My dinner plate."
    },
    {
      "start": 5.266666666666667,
      "end": 7.272,
      "text": "I licked off the fingerprints."
    },
    {
      "start": 7.392,
      "end": 9.632,
      "text": "I demanded a jury of my peers."
    },
    {
      "start": 9.752,
      "end": 11.650666666666666,
      "text": "Twelve garlic knots stood up."
    },
    {
      "start": 11.770666666666667,
      "end": 13.946666666666667,
      "text": "Tough room. I had garlic breath."
    },
    {
      "start": 14.066666666666666,
      "end": 15.24,
      "text": "Thirty minutes in the oven!"
    },
    {
      "start": 15.55,
      "end": 17.512666666666668,
      "text": "Wait. The timer says thirty-one."
    },
    {
      "start": 17.632666666666665,
      "end": 19.211333333333332,
      "text": "Their box had a guarantee."
    },
    {
      "start": 19.331333333333333,
      "end": 21.379333333333335,
      "text": "Thirty minutes or I go free."
    },
    {
      "start": 21.879333333333335,
      "end": 22.860666666666667,
      "text": "Case dismissed."
    },
    {
      "start": 22.980666666666668,
      "end": 24.836666666666666,
      "text": "I celebrated with a breadstick."
    },
    {
      "start": 25.916666666666668,
      "end": 27.538,
      "text": "It already had a lawyer."
    }
  ]
